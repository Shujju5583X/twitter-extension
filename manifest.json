{
  "manifest_version": 3,
  "name": "X-Study-Streak",
  "version": "1.1",
  "description": "Track Scrimba progress and share daily Study Streaks on X",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "*://x.com/*",
    "*://twitter.com/*",
    "*://scrimba.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://x.com/*", "*://twitter.com/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    },
    {
      "matches": ["*://scrimba.com/*"],
      "js": ["scrimba-scraper.js"]
    }
  ]
}
